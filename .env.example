# Copy to .env and fill values.

# --- App ---
APP_URL=https://sgb2-rag-production.up.railway.app/
PUBLIC_BASE_URL=https://sgb2-rag-production.up.railway.app/

# --- LLM provider: ollama | huggingface ---
LLM_PROVIDER=huggingface

# Local Ollama (quality / offline)
OLLAMA_URL=http://127.0.0.1:11434/api/generate
OLLAMA_MODEL=qwen2.5:14b-instruct
OLLAMA_TIMEOUT=120

# HuggingFace Inference Providers (portfolio / public demo)
# Token MUST include "Make calls to Inference Providers":
# https://huggingface.co/settings/tokens/new?ownUserPermissions=inference.serverless.write&tokenType=fineGrained
HF_TOKEN=
HF_MODEL=Qwen/Qwen2.5-7B-Instruct
HF_API_URL=https://router.huggingface.co/v1/chat/completions
HF_TIMEOUT=90
HF_MAX_TOKENS=1200

# Embeddings: auto (HF if token set) | huggingface | local (needs sentence-transformers)
EMBEDDING_PROVIDER=auto
EMBEDDING_MODEL=intfloat/multilingual-e5-base
# HF_EMBED_API_URL=

# --- Portfolio open access (default: no Stripe gate) ---
# Set PAYWALL_ENABLED=true only if you want paid unlock again
PAYWALL_ENABLED=false
DEMO_MODE=true
DEMO_ALLOW_DOWNLOAD=true
FULL_LETTER_PREVIEW=true
DEMO_MAX_PREVIEWS_PER_IP=30
DEMO_RATE_WINDOW_SEC=3600
DEMO_BANNER=Portfolio-Demo · voller Text + Download gratis · keine Rechtsberatung

# Optional: override repair rounds (DEMO defaults to 0 automatically)
# MAX_REPAIR_ROUNDS_CIT=0
# MAX_REPAIR_ROUNDS_STRONG=0
# Second LLM style pass (off in DEMO by default — doubles local CPU latency)
# LLM_POLISH=false

# --- RAG ---
CHROMA_COLLECTION=laws_de
DISTANCE_CUTOFF=0.22
PREVIEW_CHARS=1400
# legacy = e5 / laws_de (default, Railway-safe)
# hybrid = Qwen+BM25+RRF / wdjetzt (needs local Ollama + filled data/chroma)
RETRIEVER_BACKEND=legacy
# INGEST_COLLECTION=wdjetzt
# INGEST_REBUILD=false

# --- Stripe (optional; off in DEMO_MODE) ---
STRIPE_MODE=test
STRIPE_SECRET_KEY_TEST=
STRIPE_WEBHOOK_SECRET_TEST=
STRIPE_PRICE_ID_TEST=
STRIPE_SECRET_KEY_LIVE=
STRIPE_WEBHOOK_SECRET_LIVE=
STRIPE_PRICE_ID_LIVE=
TTL_DEFAULT_DAYS=7
PAYWALL_SECRET=
ACCESS_TOKEN_TTL_SEC=3600
PREVIEW_LINES=40

ADMIN_SECRET=

# --- Feedback email (optional) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_KEY=
SMTP_FROM=
FEEDBACK_TO=support@widerspruchjetzt.de
